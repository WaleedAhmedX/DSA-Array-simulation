//Task 9: 
//Time complexity: O(n), Space complexity: O(1)

class Solution {
public:
    int findMaxConsecutiveOnes(vector<int>& nums) {
        
        int current=0;
        int max=0;

        for(int i=0;i<nums.size();i++)
        {
            if(nums[i]!=0)
            {
                current++;
            }
            else
            {
                current=0;
            }

            if(current>=max)
            {
                 max=current;
            }

        }
        return max;

    }
};
