//Task 10:
//Time complexity: O(n), Space complexity: O(n)

class Solution {
public:
    void rotate(vector<int>& nums, int k) {

        int newpos;
        vector<int>duplicate(nums.size());

        for(int i=0;i<nums.size();i++)
        {
            newpos=(i+k)%nums.size();
            duplicate[newpos]=nums[i];
        }

        for(int i=0;i<nums.size();i++)
        {
            nums[i]=duplicate[i];
        }
       
        
    }
};
