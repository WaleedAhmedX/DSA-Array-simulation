//Task no: 1480 (running sum of 1D array)
//Time complexity= O(n), Space complexity= O(1)

class Solution {
public:
    vector<int> runningSum(vector<int>& nums) {

        int sum=0;

        for(int i=0;i<nums.size();i++)
        {
            sum=sum+nums[i];
            nums[i]=sum;

        }
        return nums;

        
    }
};
