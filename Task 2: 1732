//Task no: 1732 (Find the highest altitude)
//Time complexity= O(n), Space complexity=O(1)

class Solution {
public:
    int largestAltitude(vector<int>& gain) {

        int current=0;
        int highest=0;

        for(int i=0;i<gain.size();i++)
        {
            current=current+gain[i];

        if(current>highest)
        {
            highest=current;
        }
        
        }
        return highest;

        
    }
};
