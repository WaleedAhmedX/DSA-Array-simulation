//Task 6: 
//Space complexity: O(1), time complexity: O(n^2)

class Solution {
public:
    int numIdenticalPairs(vector<int>& nums) {

        int value=0;

        for(int i=0;i<nums.size();i++)
        {
            for(int j=0;j<nums.size();j++)
            {
                if(nums[i]==nums[j] && i<j)
                {
                    value++;
                }
            }
        }
        return value;
        
    }
};
